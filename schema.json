{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imcorp-service/ai-models/main/schema.json",
  "title": "AI model registry",
  "type": "object",
  "required": ["schema_version", "updated", "models"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "updated": {"type": "string", "format": "date"},
    "recommended": {
      "type": "object",
      "propertyNames": {"enum": ["anthropic", "openai", "gemini"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"fast": {"type": "string"}, "balanced": {"type": "string"}, "best": {"type": "string"}}
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "price": {
      "type": "object",
      "required": ["from", "unit", "input", "source"],
      "additionalProperties": false,
      "properties": {
        "from": {"$ref": "#/$defs/date"},
        "unit": {"enum": ["usd_per_mtok"]},
        "input": {"type": "number", "minimum": 0, "maximum": 1000},
        "output": {"type": "number", "minimum": 0, "maximum": 1000},
        "source": {"type": "string", "pattern": "^https://"}
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "provider", "label", "kind", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$"},
        "alias_of": {"type": "string"},
        "provider": {"enum": ["anthropic", "openai", "gemini"]},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["chat", "embedding"]},
        "tier": {"enum": ["fast", "balanced", "best"]},
        "status": {"enum": ["active", "legacy", "deprecated", "preview", "retired"]},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["text", "vision", "tools"]}},
        "requires": {"type": "array", "uniqueItems": true,
                     "items": {"enum": ["no_sampling_params", "no_thinking_budget", "no_forced_tool_choice", "thinking_always_on", "max_completion_tokens"]}},
        "retire_not_before": {"$ref": "#/$defs/date"},
        "retire_on": {"$ref": "#/$defs/date"},
        "retired_on": {"$ref": "#/$defs/date"},
        "replace_with": {"type": "string"},
        "dimensions": {"type": "integer", "minimum": 1},
        "note": {"type": "string"},
        "pricing": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/price"}},
        "pricing_verified": {"$ref": "#/$defs/date"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "retired"}}}, "then": {"required": ["retired_on", "replace_with"]}},
        {"if": {"properties": {"status": {"const": "deprecated"}}}, "then": {"required": ["retire_on", "replace_with"]}},
        {"if": {"properties": {"kind": {"const": "embedding"}}}, "then": {"required": ["dimensions"]}},
        {"if": {"properties": {"kind": {"const": "chat"}, "status": {"not": {"const": "retired"}}}, "required": ["kind"]},
         "then": {"required": ["tier", "capabilities", "requires"]}}
      ]
    }
  }
}
